rules_version = '2';

// Deny-by-default. ALL access control for this system is enforced in the FastAPI
// backend via the firebase-admin SDK, which bypasses these rules entirely.
// These rules exist so the emulator has something to load and as defense-in-depth
// in case a client SDK is ever pointed at the same project. No client is expected
// to read/write Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
