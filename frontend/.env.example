# Copy to frontend/.env for local dev.
# API base: leave as /api to use the Vite proxy to the FastAPI backend on :8000.
VITE_API_BASE=/api

# Firebase Web config. For emulator dev, a fake apiKey + the demo project id work.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-credit-audit.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-credit-audit
VITE_FIREBASE_STORAGE_BUCKET=demo-credit-audit.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id

# Use the local Auth emulator (host:port). Empty = talk to real Firebase.
VITE_AUTH_EMULATOR_HOST=localhost:9099
