# Copy to backend/.env for local dev. Defaults already target the Emulator Suite.
ENV=dev
GCP_PROJECT_ID=demo-credit-audit
STORAGE_BUCKET=demo-credit-audit.appspot.com

FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REPORT_URL_TTL_SECONDS=900

# Prod only (leave unset for dev / ADC):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
