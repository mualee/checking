{
  "name": "credit-statement-audit-frontend",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -b && vite build --mode electron",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "dev:backend": "cross-env LOCAL_MODE=1 APP_DATA_DIR=./.localdata PORT=8000 PYTHONPATH=../backend ../.venv/Scripts/python -m uvicorn app.main:app --port 8000",
    "dev:web": "vite --mode electron",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 tcp:127.0.0.1:8000 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:dev": "concurrently -k -n backend,web,electron \"npm:dev:backend\" \"npm:dev:web\" \"npm:dev:electron\"",
    "backend:build": "cross-env PYTHONPATH=../backend ../.venv/Scripts/python ../backend/build_exe.py",
    "electron:build": "npm run backend:build && npm run build:electron && electron-builder",
    "electron:pack": "npm run backend:build && npm run build:electron && electron-builder --dir"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-router": "^1.87.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jarnmua.creditaudit",
    "productName": "Credit Statement Audit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.ico"
  }
}