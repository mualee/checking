# Copy to deploy/.env ON THE EC2 SERVER (never commit it). Used by docker-compose.
ENV=prod
GCP_PROJECT_ID=checking-734d6
STORAGE_BUCKET=checking-734d6.firebasestorage.app

# Path INSIDE the container (the compose file mounts service-account.json there).
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# Your Vercel frontend origin(s), comma-separated. MUST match exactly (no trailing slash).
CORS_ORIGINS=https://your-app.vercel.app

REPORT_URL_TTL_SECONDS=900
